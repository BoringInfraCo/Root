   [[:cntrl:]])\n33:         _ord=$(printf '%d' \"'$_ch\")\n34:         case $_ord in\n35:           8) _esc=\"${_esc}\\\\b\" ;;\n36:           9) _esc=\"${_esc}\\\\t\" ;;\n37:           10) _esc=\"${_esc}\\\\n\" ;;\n38:           12) _esc=\"${_esc}\\\\f\" ;;\n39:           13) _esc=\"${_esc}\\\\r\" ;;\n40:           *) _esc=\"${_esc}\\\\u00$(printf '%02x' \"$_ord\")\" ;;\n41:         esac\n42:         ;;\n43:       *) _esc=\"${_esc}${_ch}\" ;;\n44:     esac\n45:   done\n46: }\n47: \n48: _audit() {\n49:   _code=$1\n50:   shift\n51:   _seq=0\n52:   if [ -f \"$log\" ]; then\n53:     while IFS= read -r _line || [ -n \"$_line\" ]; do\n54:       _seq=$((_seq + 1))\n55:     done < \"$log\"\n56:   fi\n57:   _seq=$((_seq + 1))\n58:   _args=\n59:   _sep=\n60:   for _arg in \"$@\"; do\n61:     _json_escape \"$_arg\"\n62:     _args=\"${_args}${_sep}\\\"${_esc}\\\"\"\n63:     _sep=,\n64:   done\n65:   _json_escape \"$tool\"\n66:   printf '%s\\n' \"{\\\"seq\\\":${_seq},\\\"tool\\\":\\\"${_esc}\\\",\\\"argv\\\":[${_args}],\\\"exit\\\":${_code},\\\"profile\\\":\\\"${profile}\\\"}\" >> \"$log\"\n67: }\n68: \n69: _stub_binary() {\n70:   case $1 in\n71:     ripgrep) _bin=rg ;;\n72:     fd) _bin=fd ;;\n73:     jq) _bin=jq ;;\n74:     poppler) _bin=pdftotext ;;\n75:     *) _bin=$1 ;;\n76:   esac\n77: }\n78: \n79: _exit=0\n80: _cmd=${1:-}\n81: case \"$_cmd\" in\n82:   doctor)\n83:     printf '%s\\n' '{\"healthy\":true,\"nix_installed\":true,\"root_initialized\":true,\"issues\":[]}'\n84:     ;;\n85:   plan)\n86:     _sub=${2:-}\n87:     _pkg=${3:-}\n88:     if [ \"$_sub\" = install ] && [ \"$_pkg\" = ambiguous-tool ]; then\n89:       printf '%s\\n' '{\"success\":true,\"package\":\"ambiguous-tool\",\"found\":true,\"candidates\":[{\"name\":\"ambiguous-tool-cli\",\"description\":\"Command-line tools for ambiguous-tool\"},{\"name\":\"ambiguous-tool-lib\",\"description\":\"Libraries for ambiguous-tool\"}],\"message\":\"ambiguous package name: 2 candidates found\"}'\n90:     elif [ \"$_sub\" =