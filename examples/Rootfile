[packages]
node = "22.11.0"
postgresql = "16.4"
poppler = "24.08.0"
ffmpeg = "7.1"
ripgrep = "14.1.1"

# Declared agents (v0.2.5+) and models (v0.3.0). Mutating this file with Root
# v0.2.4 drops these tables — use v0.2.5+ for any command that rewrites Rootfile.
#
# [agents] are presence-only. Root inspects them; it does not install them.
# [agents]
# codex = "*"
# claude = "*"
# opencode = "*"
# pi = "*"
#
# [models] accept runtime = "ollama" only. No digest. No endpoint.
# `root plan models` previews. `root models pull` pulls the tag and writes a
# v3 verification record in root.lock. Restore/rollback copy that record;
# they do not pull or delete Ollama weights.
# [models."qwen3:8b"]
# runtime = "ollama"

[settings]
snapshots = true
verify_installs = true
